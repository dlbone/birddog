[Unit]
Description=Birddog collage index and image refresh
After=birdnet_analysis.service

[Service]
Type=oneshot
User=admin
Group=admin
Environment=HOME=/home/admin
WorkingDirectory=/home/admin/BirdNET-Pi
ExecStart=/home/admin/BirdNET-Pi/birdnet/bin/python3 /home/admin/BirdNET-Pi/scripts/bird_collage.py --all-ranges --limit 28 --generate --variant both --max-new 2
