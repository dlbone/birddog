# Optional one-off environment overrides for Birddog commands.
# The installer stores the Gemini key in /etc/birdnet/gemini_api_key, which is
# preferred for the Raspberry Pi service setup. Export GEMINI_API_KEY before
# running ./install.sh if you want the installer to write that key for you.

GEMINI_API_KEY=replace-with-your-key
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
