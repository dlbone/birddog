# Optional one-off environment overrides for Birddog commands.
# The installer stores the Gemini key in /etc/birdnet/gemini_api_key, which is
# preferred for the Raspberry Pi service setup. Use this file only for manual
# command-line runs or local development.

GEMINI_API_KEY=replace-with-your-key
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
